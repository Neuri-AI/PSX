{
    "app_name": "psx-qyro-pydux-demo",
    "author": "PSX",
    "entry_point": "main.py",
    "addons": ["pydux"],
    "version": "0.1.0",
    "binding": "PySide6",
    "hidden_imports": [
        "__future__"
    ],
    "hot_reload": {
        "enabled": true,
        "watch": ["."],
        "module_reload": {
            "include": [],
            "exclude": ["PySide6.*", "PyQt6.*", "numpy.*"],
            "third_party": "restart"
        },
        "preserve_state": true,
        "fallback": "restart"
    }
}
